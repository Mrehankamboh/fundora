DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PORT=5173
SESSION_COOKIE=fundora_session
APP_ORIGIN=http://127.0.0.1:5173

# Gmail SMTP (App Password — not your normal Gmail password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Google OAuth (same flow as FundingPips)
# Authorized redirect URI: http://127.0.0.1:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Challenge checkout (Stripe Card). Leave empty to use Demo pay locally.
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional USDT address shown on crypto checkout
CRYPTO_USDT_ADDRESS=
CRYPTO_USDT_NETWORK=TRC20
# When Stripe is configured, set true to auto-activate after "I've sent payment"
CRYPTO_AUTO_CONFIRM=false
